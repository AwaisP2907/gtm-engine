              "onerror": [
                {
                  "id": 140,
                  "module": "http:ActionSendData",
                  "version": 3,
                  "mapper": {
                    "url": "{{SLACK_WEBHOOK_URL}}",
                    "method": "post",
                    "headers": [],
                    "bodyType": "raw",
                    "contentType": "application/json",
                    "data": "{\"text\": \":rotating_light: *GTM Engine error* in step _HubSpot update_ for *{{1.company}}* ({{1.account_key}}). Record skipped. Error: {{error.message}}\"}"
                  },
                  "parameters": {
