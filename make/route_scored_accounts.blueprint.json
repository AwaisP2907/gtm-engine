                  "version": 1,
                  "mapper": null,
                  "parameters": {}
                }
              ],
              "filter": {
                "name": "Tier C / DQ -> park",
                "conditions": [
                  [
                    {
                      "a": "{{1.tier}}",
                      "b": "A",
                      "o": "text:notequal"
                    },
                    {
                      "a": "{{1.tier}}",
                      "b": "B",
                      "o": "text:notequal"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    }
  }
}