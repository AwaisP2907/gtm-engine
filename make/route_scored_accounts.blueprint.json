                    "data": "{\"text\": \":rotating_light: *GTM Engine error* in step _Slack alert_ for *{{1.company}}* ({{1.account_key}}). Record skipped. Error: {{error.message}}\"}"
                  },
                  "parameters": {
                    "handleErrors": true
                  },
                  "metadata": {
                    "designer": {
                      "name": "Error -> #gtm-engine-alerts"
                    }
                  }
                },
                {
                  "id": 121,
                  "module": "builtin:Ignore",
                  "version": 1,
                  "mapper": null,
                  "parameters": {}
                }
              ],
              "filter": {
                "name": "Tier A + Mid-Market/SMB/Unknown",
                "conditions": [
                  [
                    {
                      "a": "{{1.tier}}",
                      "b": "A",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{1.segment}}",
                      "b": "enterprise",
                      "o": "text:notequal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 21,
              "module": "http:ActionSendData",
              "version": 3,
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/companies/{{1.hubspot_id}}",
                "data": "{\"properties\": {\"gtm_engine_status\": \"routed\", \"gtm_routing_owner\": \"SDR - Mid-Market\"}}",
                "method": "patch",
                "headers": [
