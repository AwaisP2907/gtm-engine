                }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 30,
              "module": "http:ActionSendData",
              "version": 3,
              "mapper": {
                "url": "https://api.hubapi.com/crm/v3/objects/companies/{{1.hubspot_id}}",
                "data": "{\"properties\": {\"gtm_engine_status\": \"routed\", \"gtm_routing_owner\": \"Nurture sequence\"}}",
                "method": "patch",
